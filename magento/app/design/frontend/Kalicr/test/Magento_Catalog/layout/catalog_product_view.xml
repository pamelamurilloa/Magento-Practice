<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <move element="product.info.review" destination="product.info.main" after="product.price.tier" />
        <referenceBlock name="product.info.main">
            <block class="Magento\Framework\View\Element\Template"
                   name="textArea"
                   template="Magento_Catalog::text-area.phtml"
                   after="product.info.addtocart" />
        </referenceBlock> 

        <referenceBlock name="content">
            <block class="Magento\Framework\View\Element\Template"
                   name="banner.image"
                   template="Magento_Catalog::image.phtml"
                   after="product.info.main" />
        </referenceBlock> 

        <referenceBlock name="product.info.details">
            <block class="Magento\Framework\View\Element\Template"
                   name="custom.tab.pdf"
                   template="Magento_Catalog::custom-tab-pdf.phtml"
                   group="detailed_info"
                   after="additional">
                   <arguments>
                       <argument name="title" xsi:type="string">Product PDF</argument>
                   </arguments>
            </block>
        </referenceBlock>
    </body>
</page>