<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="kalicr_brandlisting_brand" resource="default" engine="innodb" comment="Brand Table">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Brand Name"/>
        <column xsi:type="varchar" name="logo" nullable="true" length="255" comment="Brand Logo Path"/>
        <column xsi:type="varchar" name="selector_id" nullable="true" length="255" comment="Selector Attribute ID"/>
        <column xsi:type="int" name="position" nullable="false" default="0" comment="Position"/>
        <column xsi:type="smallint" name="is_active" nullable="false" default="1" comment="Status"/>

        <column xsi:type="int" name="category_id" nullable="true" comment="Category ID"/>
        <column xsi:type="varchar" name="banner" nullable="true" length="255" comment="Banner Path"/>
        <column xsi:type="text" name="description" nullable="true" comment="Description"/>

        <column xsi:type="varchar" name="province" nullable="true" length="255" comment="Province"/>
        <column xsi:type="varchar" name="canton" nullable="true" length="255" comment="Canton"/>
        <column xsi:type="varchar" name="district" nullable="true" length="255" comment="District"/>
        <column xsi:type="text" name="exact_address" nullable="true" comment="Exact Address"/>
        <column xsi:type="varchar" name="latitude" nullable="true" length="50" comment="Latitude"/>
        <column xsi:type="varchar" name="longitude" nullable="true" length="50" comment="Longitude"/>

        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
    </table>
</schema>

<!--
after adding this db_schema.xml file, run the following commands to apply the schema changes:
php bin/magento setup:upgrade
php bin/magento cache:flush
-->