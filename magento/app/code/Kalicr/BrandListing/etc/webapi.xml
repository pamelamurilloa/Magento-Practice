<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/brands/:brandId" method="GET">
        <service class="Kalicr\BrandListing\Api\BrandManagementInterface" method="getById"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>

    <route url="/V1/brands" method="POST">
        <service class="Kalicr\BrandListing\Api\BrandManagementInterface" method="save"/>
        <resources>
            <resource ref="Magento_Backend::admin"/>
        </resources>
    </route>

    <route url="/V1/brands/:brandId" method="PUT">
        <service class="Kalicr\BrandListing\Api\BrandManagementInterface" method="save"/>
        <resources>
            <resource ref="Magento_Backend::admin"/>
        </resources>
    </route>

    <route url="/V1/brands/:brandId" method="DELETE">
        <service class="Kalicr\BrandListing\Api\BrandManagementInterface" method="deleteById"/>
        <resources>
            <resource ref="Magento_Backend::admin"/>
        </resources>
    </route>
</routes>